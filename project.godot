; Engine configuration file.
config_version=5

[application]

config/name="The Building of a Dynasty"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[gui]

theme/default_font_antialiasing=1
theme/default_font_subpixel_positioning=1

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_2d=2
